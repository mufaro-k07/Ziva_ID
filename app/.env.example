# ZivaID API — environment contract
# Copy to .env and fill in. Every variable below is validated at startup
# by src/lib/env.ts; the server refuses to boot on a bad value.

# development | production
NODE_ENV=development

# Port the API listens on.
# NOTE: do NOT also define a lowercase `port=` in this file. Windows resolves
# environment variables case-insensitively, so `port=5432` would silently
# override PORT and the server would try to bind the database port.
PORT=3000

# --- Database (required) ---
# Full Postgres connection string, e.g.
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# --- Better Auth (required) ---
# Must be at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of THIS API, e.g. https://api.zivaid.example
BETTER_AUTH_URL=http://localhost:3000

# --- Origins ---
# Comma-separated. Both are REQUIRED when NODE_ENV=production, and must be
# https:// there. In development they default to http://localhost:5173.
#
# CORS_ORIGINS    — browser origins allowed to call this API with credentials
# TRUSTED_ORIGINS — origins Better Auth accepts for sign-in / callback flows
# In a typical deployment both are the frontend URL, e.g. https://zivaid.example
CORS_ORIGINS=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
