# ZivaID frontend — environment contract
# Copy to .env and fill in. Vite inlines these at BUILD time, not runtime.
#
# ⚠️ Every VITE_* value is embedded in the browser bundle and is therefore
# PUBLIC. Never put DATABASE_URL, BETTER_AUTH_SECRET, or any other credential
# behind a VITE_ prefix.

# Base URL of the ZivaID API.
# Used by src/lib/auth-client.ts (Better Auth client) and as API_BASE in
# src/utils/records.js, src/pages/citizen/intakeForm.jsx and
# src/pages/citizen/citizenDashboard.jsx.
# Local development default if unset: http://localhost:3000
VITE_BETTER_AUTH_URL=http://localhost:3000
